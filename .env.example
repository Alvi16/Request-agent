# Configuration of the whole project. Copy this file to .env and set a password.

# --- Database: local PostgreSQL started with Docker Compose ---

# Password of the request_agent database user. Use any local value, never a real one.
POSTGRES_PASSWORD=change-me

# Host port of the database. 5433 avoids a conflict with another PostgreSQL on 5432.
POSTGRES_PORT=5433

# Connection to the development database. Use the same password and port as above.
DATABASE_URL=postgresql://request_agent:change-me@127.0.0.1:5433/request_agent

# Connection used by the application, with the restricted request_agent_app role. The migrations
# create the role and `pnpm db:migrate` sets its password from this URL. Use another password.
APP_DATABASE_URL=postgresql://request_agent_app:change-me-too@127.0.0.1:5433/request_agent

# Database used by the tests. Its name must end with _test: the tests empty it before each test.
TEST_DATABASE_URL=postgresql://request_agent:change-me@127.0.0.1:5433/request_agent_test

# --- Agent server ---

# Ollama API endpoint (default local install). Must end with /api.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Ollama model used by the agent. It must be pulled first: ollama pull ornith:9b
OLLAMA_MODEL=ornith:9b

# Below this confidence, from 0 to 1, a classified request waits for a human review. Optional:
# the default, 0.8, comes from the measurements described in docs/agent.md.
# CLASSIFICATION_REVIEW_THRESHOLD=0.8

# --- Web interface of the team, started with `pnpm web` ---
# It uses APP_DATABASE_URL. Accounts are created with `pnpm staff:add`.

# Address and port it listens on. Optional: by default only this machine, on port 4112. Expose it
# to the network only behind HTTPS: the session cookie is kept over HTTPS, or on localhost by Chrome
# and Firefox (not Safari).
# WEB_HOST=127.0.0.1
# WEB_PORT=4112

# Time zone of the dates shown, as an IANA name. Optional, Europe/Paris by default.
# WEB_TIME_ZONE=Europe/Paris

# --- Slack, optional: without these two tokens, the server runs without Slack ---

# Bot token of the Slack app (OAuth & Permissions > Bot User OAuth Token). Starts with xoxb-.
# SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token with the connections:write scope (Basic Information > App-Level Tokens), used to
# open the Socket Mode connection. Starts with xapp-.
# SLACK_APP_TOKEN=xapp-your-app-token

# --- Email: the agent's mailbox ---
# The values below fit the local mail server started by `pnpm db:up`. For a real mailbox, set its
# IMAP and SMTP servers, with EMAIL_SECURE=true.

# Login and password of the mailbox. On the local server, the password is chosen here.
EMAIL_USER=agent
EMAIL_PASSWORD=change-me-mail
# Address the agent receives and answers from.
EMAIL_ADDRESS=agent@requests.example
EMAIL_IMAP_HOST=127.0.0.1
EMAIL_IMAP_PORT=3143
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=3025
# true to connect with TLS, as real mail servers require.
EMAIL_SECURE=false

# Server name written by the receiving mail server in its Authentication-Results header, such as
# mx.google.com. Only that header is trusted to tell that a sender passed DMARC. Optional: without
# it, every email sender is unverified.
# EMAIL_TRUSTED_AUTHSERV_ID=mx.google.com

# Local tests only: treat every email sender as verified. Refused unless the mailbox is on this
# machine, since the local server checks no sender.
# EMAIL_TRUST_LOCAL_SENDERS=true

# Mailbox of the tests, on the local server. The tests empty it.
TEST_EMAIL_USER=agent-test
TEST_EMAIL_PASSWORD=change-me-mail-test
