# Configuration of the whole project. Copy this file to .env and set a password.

# --- Database: local PostgreSQL started with Docker Compose ---

# Password of the request_agent database user. Use any local value, never a real one.
POSTGRES_PASSWORD=change-me

# Host port of the database. 5433 avoids a conflict with another PostgreSQL on 5432.
POSTGRES_PORT=5433

# Connection to the development database. Use the same password and port as above.
DATABASE_URL=postgresql://request_agent:change-me@127.0.0.1:5433/request_agent

# Database used by the tests. Its name must end with _test: the tests empty it before each test.
TEST_DATABASE_URL=postgresql://request_agent:change-me@127.0.0.1:5433/request_agent_test

# --- Agent server ---

# Ollama API endpoint (default local install). Must end with /api.
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Ollama model used by the agent. It must be pulled first: ollama pull ornith:9b
OLLAMA_MODEL=ornith:9b
