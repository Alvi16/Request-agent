{
  "name": "@request-agent/server",
  "version": "0.1.0",
  "private": true,
  "description": "Mastra server: agent, tools and channel adapters",
  "type": "module",
  "scripts": {
    "dev": "mastra dev --env ../../.env",
    "build": "mastra build",
    "start": "mastra start --env ../../.env",
    "demo:email": "node --env-file-if-exists=../../.env scripts/demo-email.ts",
    "demo:widget": "node --env-file-if-exists=../../.env scripts/demo-widget.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "catalog:",
    "@request-agent/core": "workspace:*",
    "@slack/socket-mode": "catalog:",
    "@slack/web-api": "catalog:",
    "email-reply-parser": "catalog:",
    "hono": "catalog:",
    "imapflow": "catalog:",
    "nodemailer": "catalog:",
    "ollama-ai-provider-v2": "catalog:",
    "postal-mime": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "mastra": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
