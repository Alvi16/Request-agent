{
  "name": "@request-agent/core",
  "version": "0.1.0",
  "private": true,
  "description": "Business core: data model and database access, independent of any channel",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/index.ts",
    "./testing/global-setup": "./test/global-setup.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
    "staff:add": "node --env-file-if-exists=../../.env scripts/add-staff.ts",
    "contact:add": "node --env-file-if-exists=../../.env scripts/add-contact.ts",
    "eval:classification": "node --env-file-if-exists=../../.env scripts/eval-classification.ts",
    "eval:duplicates": "node --env-file-if-exists=../../.env scripts/eval-duplicates.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
