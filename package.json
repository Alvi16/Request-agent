{
  "name": "request-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-channel AI agent for request management (Slack, Email) built with Mastra",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "dev": "pnpm --filter @request-agent/server dev",
    "build": "pnpm --filter @request-agent/server build",
    "start": "pnpm --filter @request-agent/server start",
    "web": "pnpm --filter @request-agent/web start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @request-agent/core db:generate",
    "db:migrate": "pnpm --filter @request-agent/core db:migrate",
    "db:seed": "pnpm --filter @request-agent/core db:seed",
    "staff:add": "pnpm --filter @request-agent/core staff:add",
    "contact:add": "pnpm --filter @request-agent/core contact:add",
    "kb:import": "pnpm --filter @request-agent/core kb:import",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "eval:classification": "pnpm --filter @request-agent/core eval:classification",
    "eval:duplicates": "pnpm --filter @request-agent/core eval:duplicates",
    "demo:email": "pnpm --filter @request-agent/server demo:email",
    "lint": "oxlint",
    "format": "prettier . --write --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "format:check": "prettier . --check --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
